{
  "name": "@marianmeres/mcp-server",
  "version": "1.3.2",
  "description": "Plugin-based MCP server that gives AI coding agents a package ecosystem's docs and package-provided tools over stdio.",
  "license": "MIT",
  "author": "Marian Meres",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "bin": {
    "mcp-server": "./dist/main.js"
  },
  "exports": {
    "./types": {
      "types": "./dist/mod.d.ts",
      "default": "./dist/mod.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marianmeres/mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/marianmeres/mcp-server/issues"
  },
  "homepage": "https://github.com/marianmeres/mcp-server#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "stdio",
    "plugins",
    "ai",
    "agents"
  ],
  "scripts": {
    "start": "node src/main.ts",
    "inspect": "npx @modelcontextprotocol/inspector -- node src/main.ts --config ./mcp.config.json",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:watch": "node --test --watch \"tests/**/*.test.ts\"",
    "ci": "pnpm run typecheck && pnpm run lint && pnpm test",
    "prepublishOnly": "pnpm run ci && pnpm run build",
    "release": "npx --yes @marianmeres/release@^2.2.0",
    "rp": "pnpm run release -y && pnpm publish",
    "rpm": "pnpm run release minor -y && pnpm publish"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
