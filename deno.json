{
	"name": "@marianmeres/mcp-server",
	"version": "1.1.0",
	"exports": {
		".": "./main.ts",
		"./types": "./src/mod.ts"
	},
	"tasks": {
		"start": "deno run -A main.ts",
		"inspect": "npx @modelcontextprotocol/inspector -- deno run -A main.ts --config ./mcp.config.json",
		"test": "deno test -A",
		"test:watch": "deno test -A --watch",
		"release": "deno run -A jsr:@marianmeres/deno-release",
		"publish": "deno publish",
		"rp": "deno task release -y && deno task publish",
		"rpm": "deno task release minor -y && deno task publish"
	},
	"imports": {
		"@marianmeres/npmbuild": "jsr:@marianmeres/npmbuild@^1.11.0",
		"@modelcontextprotocol/sdk/server/mcp.js": "npm:@modelcontextprotocol/sdk@^1.12.0/server/mcp.js",
		"@modelcontextprotocol/sdk/server/stdio.js": "npm:@modelcontextprotocol/sdk@^1.12.0/server/stdio.js",
		"@std/assert": "jsr:@std/assert@^1.0.19",
		"@std/cli": "jsr:@std/cli@^1.0.0",
		"@std/fs": "jsr:@std/fs@^1.0.23",
		"@std/path": "jsr:@std/path@^1.1.4",
		"zod": "npm:zod@^3.24.0"
	},
	"fmt": {
		"useTabs": true,
		"lineWidth": 90,
		"indentWidth": 4,
		"proseWrap": "preserve"
	}
}
